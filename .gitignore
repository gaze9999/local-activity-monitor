# Python environments, caches and build output
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Private recordings, databases, logs and recovery files
*.sqlite*
*.db
*.db-*
*.jsonl
*.log
*.bak
state/

# Local settings; keep distributable examples visible
.env
.env.*
!.env.example
.agents/
.local/

# Portable role sources remain visible inside the local Codex directory
.codex/*
!.codex/agents/
.codex/agents/*
!.codex/agents/*.toml
!.codex/agent-guidance/
.codex/agent-guidance/*
!.codex/agent-guidance/roles.md

# Browser validation output and generated shared UI assets
.playwright-cli/
.workbench-ui/
src/local_activity_monitor/_workbench/
src/local_activity_monitor/_web/

# Operating-system metadata
.DS_Store
Thumbs.db

# Actual project instructions and roles stay local
/AGENTS.md
/.codex/agent-guidance/roles.md
/.codex/agents/metadata-collector-engineer.toml
/.codex/agents/monitor-privacy-reviewer.toml
/.codex/agents/monitor-ui-reviewer.toml

# Local builds and validation caches
/.tmp/
/tmp/
/test-results/
/playwright-report/
/coverage/
